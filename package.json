{
  "name": "orobotics-website",
  "version": "1.0.0",
  "private": true,
  "description": "Orbitus Robotics Hugo website and optimized media gallery",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "alpinejs": "^3.14.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.14"
  },
  "scripts": {
    "start": "concurrently npm:watch:*",
    "watch:tw": "tailwindcss -i ./assets/css/main.css -o ./assets/css/style.css --watch",
    "watch:hugo": "hugo server",
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/style.css --minify && node scripts/normalize-generated-css.mjs",
    "build": "npm run build:css && hugo --gc --minify",
    "validate": "node scripts/validate-gallery.mjs",
    "validate:subpath": "node scripts/validate-subpath.mjs",
    "test:game": "node --test tests/rob-game-rules.test.mjs",
    "test": "npm run test:game && npm run build && npm run validate && npm run validate:subpath"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OrbitusRoboticsWebSite/ORobotics.git"
  },
  "keywords": [
    "hugo",
    "tailwind",
    "tailwindcss",
    "alpinejs",
    "robotics",
    "responsive-gallery",
    "web-performance"
  ],
  "author": "Orbitus Robotics",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/OrbitusRoboticsWebSite/ORobotics/issues"
  },
  "homepage": "https://www.orbitusrobotics.com/",
  "dependencies": {
    "three": "^0.180.0"
  }
}
