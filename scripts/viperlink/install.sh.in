#!/bin/sh
# Generated by scripts/viperlink/render.py. Reviewable, per-user source installer.
set -eu
umask 077
VERSION='@VERSION@'
BASE='https://www.orbitusrobotics.com/v/packages/@VERSION@'
component=cloud
prefix=''
source_dir=''
dry_run=0
fail() { printf 'ViperLink: %s\n' "$*" >&2; exit 1; }
while [ "$#" -gt 0 ]; do
    case "$1" in
        --component|--prefix|--source-dir)
            [ "$#" -ge 2 ] || fail "Missing value for $1"
            case "$1" in --component) component=$2;; --prefix) prefix=$2;; --source-dir) source_dir=$2;; esac
            shift 2;;
        --dry-run) dry_run=1; shift;;
        --help) printf '%s\n' 'sh install.sh [--component cloud|status|lan] [--prefix ABSOLUTE_DIRECTORY] [--dry-run] [--source-dir LOCAL_PACKAGE_DIRECTORY]' 'Installs source only. Private enrollment and starting the selected tool are separate steps.'; exit 0;;
        *) fail "Unknown option: $1";;
    esac
done
case "$component" in cloud|status|lan);; *) fail 'Choose cloud, status or lan';; esac
system=$(uname -s)
case "$system" in
    Darwin) default_prefix="$HOME/Library/Application Support/Orbitus/ViperLink";;
    Linux) default_prefix="$HOME/.local/share/Orbitus/ViperLink";;
    *) fail 'Use install.ps1 on Windows. This installer supports macOS and Linux.';;
esac
[ -n "$prefix" ] || prefix=$default_prefix
case "$prefix" in /*);; *) fail 'The install prefix must be absolute';; esac
case "$prefix/" in /|//|*/../*|*/./*) fail 'Choose a dedicated, normalized ViperLink directory';; esac
destination="$prefix/$component/$VERSION"
files() {
    case "$component" in
@FILE_CASES@
    esac
}
printf 'ViperLink %s source pilot\nComponent: %s\nInstall to: %s\n' "$VERSION" "$component" "$destination"
if [ "$component" = lan ]; then
    printf '%s\n' 'Requires Python 3.10+ with OpenSSL TLS 1.3. LAN controller only; remote host provisioned separately.'
else
    printf '%s\n' 'Requires an existing Node.js 22+ runtime. Fleet credentials provisioned separately.'
fi
[ "$dry_run" -eq 0 ] || { files; exit 0; }
if [ "$component" = lan ]; then
    command -v python3 >/dev/null 2>&1 || fail 'Install Python 3.10+ from python.org or your approved package manager first.'
    python3 -c 'import sys,ssl; sys.exit(0 if sys.version_info >= (3,10) and ssl.HAS_TLSv1_3 and hasattr(ssl,"VERIFY_X509_PARTIAL_CHAIN") else 1)' || fail 'Python needs version 3.10+ and OpenSSL TLS 1.3.'
else
    command -v node >/dev/null 2>&1 || fail 'Install Node.js 22+ from nodejs.org or your approved package manager first.'
    node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)' || fail 'Node.js 22+ is required.'
fi
hash_file() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}';
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}';
    else fail 'A SHA-256 utility (shasum or sha256sum) is required.'; fi
}
# Reject symlink ancestors before creating or writing any installation directories.
ancestor=$destination
while [ "$ancestor" != / ]; do
    [ ! -L "$ancestor" ] || fail "Symlink install path: $ancestor"
    ancestor=$(dirname "$ancestor")
done
mkdir -p "$prefix/$component"
lock="$prefix/.install-lock"
mkdir "$lock" 2>/dev/null || fail 'Another installation is active, or a prior lock needs review.'
work=''
cleanup() { [ -z "$work" ] || rm -rf "$work"; rmdir "$lock"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
receipt="orbitus-viperlink $VERSION $component @SOURCE_COMMIT@"
verify() {
    directory=$1
    files | while read -r expected name; do
        [ ! -L "$directory/$name" ] && [ -f "$directory/$name" ] || fail "Missing or non-regular file: $name"
        [ "$(hash_file "$directory/$name")" = "$expected" ] || fail "SHA-256 mismatch: $name"
    done
}
if [ -e "$destination" ]; then
    [ -f "$destination/installation.txt" ] && [ ! -L "$destination/installation.txt" ] || fail 'Existing directory is unmanaged; it was preserved.'
    [ "$(cat "$destination/installation.txt")" = "$receipt" ] || fail 'Existing installation receipt differs; it was preserved.'
    verify "$destination"
    printf 'ViperLink %s is already installed and verified.\n' "$component"
    exit 0
fi
work=$(mktemp -d "$prefix/$component/.install.XXXXXXXX")
mkdir "$work/payload"
files | while read -r expected name; do
    if [ -n "$source_dir" ]; then
        [ ! -L "$source_dir/$name" ] && [ -f "$source_dir/$name" ] || fail "Invalid local source: $name"
        cp "$source_dir/$name" "$work/payload/$name"
    else
        curl -fsSL --proto '=https' --proto-redir '=https' --connect-timeout 15 --max-time 120 "$BASE/$component/$name" -o "$work/payload/$name"
    fi
done
verify "$work/payload"
printf '%s\n' "$receipt" > "$work/payload/installation.txt"
mv "$work/payload" "$destination"
printf '\nInstalled ViperLink %s. Read: %s/START.txt\n' "$component" "$destination"
printf '%s\n' 'Installation is complete. Enrollment and execution have not been started.'
