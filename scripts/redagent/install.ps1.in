# Generated by scripts/redagent/render.py. Requires Windows PowerShell 5.1+.
[CmdletBinding()]
param([string]$InstallDir = '', [string]$ArchivePath = '', [switch]$DryRun,
      [ValidateSet('User','Machine')][string]$Scope = 'User', [string]$ControlUser = '')
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest
$version = '@VERSION@'
$sourceCommit = '@SOURCE_COMMIT@'
$expected = '@WINDOWS_SHA256@'
$url = '@BASE_URL@/@WINDOWS_FILENAME@'
$apiUrl = '@WINDOWS_API_URL@'
if ($env:OS -ne 'Windows_NT') { throw 'Use install.sh for macOS and Linux.' }
$machine = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }
if ($machine -ne 'AMD64') { throw "Unsupported architecture: $machine. This pilot requires Windows x64." }
if ($Scope -eq 'Machine') {
    $identity = [Security.Principal.WindowsIdentity]::GetCurrent()
    $principal = New-Object Security.Principal.WindowsPrincipal($identity)
    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Use the administrator install command and approve the Windows UAC prompt.' }
    if (-not $ControlUser) { $ControlUser = $identity.User.Value }
    if ($ControlUser -notmatch '^S-1-5-(\d+-)*\d+$') { throw 'Invalid installing operator SID.' }
    $machineInstall = Join-Path $env:ProgramFiles 'Orbitus\RedAgent'
    if ($InstallDir -and [IO.Path]::GetFullPath($InstallDir) -ne $machineInstall) { throw 'Machine installs use the protected Program Files location.' }
    $InstallDir = $machineInstall
} elseif (-not $InstallDir) { $InstallDir = Join-Path $env:LOCALAPPDATA 'Programs\Orbitus\RedAgent' }
if (-not [IO.Path]::IsPathRooted($InstallDir)) { throw 'InstallDir must be an absolute path.' }
$InstallDir = [IO.Path]::GetFullPath($InstallDir).TrimEnd('\', '/')
if ($InstallDir -eq [IO.Path]::GetPathRoot($InstallDir).TrimEnd('\', '/')) { throw 'Use a dedicated install directory.' }
$exe = Join-Path $InstallDir 'RedAgent\RedAgent.exe'
function Complete-Installation {
    if ($Scope -eq 'Machine') {
        & icacls.exe $InstallDir /inheritance:r /grant:r '*S-1-5-18:(OI)(CI)F' '*S-1-5-32-544:(OI)(CI)F' '*S-1-5-32-545:(OI)(CI)RX' | Out-Null
        if ($LASTEXITCODE -ne 0) { throw 'Unable to protect machine installation.' }
        & icacls.exe (Join-Path $InstallDir '*') /reset /T | Out-Null
        if ($LASTEXITCODE -ne 0) { throw 'Unable to protect application files.' }
        $helper = Join-Path $InstallDir 'RedAgentHelper'
        & (Join-Path $helper 'RedAgentHelper.exe') install --source $helper --control-user $ControlUser
        if ($LASTEXITCODE -ne 0) { throw 'App installed, but the system helper could not be installed. Review the error above.' }
        $service = Get-Service -Name OrbitusRedAgent -ErrorAction Stop
        # SCM can return while the replacement is still START_PENDING.
        $service.WaitForStatus([System.ServiceProcess.ServiceControllerStatus]::Running, [TimeSpan]::FromSeconds(45))
        if ((Get-ItemProperty 'HKLM:\SYSTEM\CurrentControlSet\Services\OrbitusRedAgent').Start -ne 2) { throw 'Helper automatic startup was not configured.' }
    }
    $folder = if ($Scope -eq 'Machine') { 'CommonPrograms' } else { 'Programs' }
    $programs = [Environment]::GetFolderPath($folder)
    if ($programs) {
        $shortcut = (New-Object -ComObject WScript.Shell).CreateShortcut((Join-Path $programs 'RedAgent.lnk'))
        $shortcut.TargetPath = $exe
        $shortcut.WorkingDirectory = Split-Path -Parent $exe
        $shortcut.Save()
    }
    if ($Scope -eq 'Machine') {
        Write-Host 'Installed for all users. OrbitusRedAgent is running as LocalService and starts at boot, before login.'
        Write-Host 'Open RedAgent to import private enrollment. Cloud commands remain disabled until explicitly enabled.'
    } else {
        Write-Host 'User installation only. For startup across users, choose the separate administrator Flipper script.'
    }
}
Write-Host "RedAgent $version pilot`nPlatform: Windows/$machine`nScope: $Scope`nDownload: $url`nSHA-256: $expected`nInstall to: $InstallDir"
if ($DryRun) { Write-Host 'Preview only; no download or installation.'; return }
if (Test-Path -LiteralPath $InstallDir) {
    $item = Get-Item -LiteralPath $InstallDir
    if ($item.Attributes -band [IO.FileAttributes]::ReparsePoint) { throw 'Install directory must not be a link or junction.' }
    $receiptPath = Join-Path $InstallDir 'installation.json'
    if (-not (Test-Path -LiteralPath $receiptPath)) { throw 'Existing directory is not a managed RedAgent installation.' }
    $receipt = Get-Content -LiteralPath $receiptPath -Raw | ConvertFrom-Json
    if ($receipt.installer -ne 'orbitus-redagent') { throw 'Existing directory is not a managed RedAgent installation.' }
    if ($receipt.archiveSHA256 -eq $expected -and (Test-Path -LiteralPath $exe)) {
        Complete-Installation
        Write-Host "RedAgent $version is already installed at $InstallDir"; return
    }
}
$parent = Split-Path -Parent $InstallDir
New-Item -ItemType Directory -Force -Path $parent | Out-Null
$work = Join-Path $parent ('.redagent-install-' + [guid]::NewGuid())
New-Item -ItemType Directory -Path $work | Out-Null
$backup = $null
$placed = $false
try {
    $bundle = Join-Path $work 'bundle.zip'
    if ($ArchivePath) { Copy-Item -LiteralPath $ArchivePath -Destination $bundle }
    else {
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        for ($attempt = 1; $attempt -le 3; $attempt++) {
            try {
                if ($attempt -eq 3) {
                    Invoke-WebRequest -UseBasicParsing -Uri $apiUrl -Headers @{ Accept='application/octet-stream'; 'X-GitHub-Api-Version'='2022-11-28' } -OutFile $bundle -TimeoutSec 600
                } else {
                    Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $bundle -TimeoutSec 600
                }
                break
            } catch {
                if ($attempt -eq 3) { throw }
                Write-Warning "Download attempt $attempt failed. Retrying..."
                Start-Sleep -Seconds (2 * $attempt)
            }
        }
    }
    # Framework APIs also work when the host omits optional PowerShell module paths.
    $sha = [Security.Cryptography.SHA256]::Create()
    $stream = [IO.File]::OpenRead($bundle)
    try { $actual = [BitConverter]::ToString($sha.ComputeHash($stream)).Replace('-', '').ToLowerInvariant() }
    finally { $stream.Dispose(); $sha.Dispose() }
    if ($actual -ne $expected) {
        throw 'SHA-256 mismatch; nothing was installed.'
    }
    $payload = Join-Path $work 'payload'
    Add-Type -AssemblyName System.IO.Compression.FileSystem
    [IO.Compression.ZipFile]::ExtractToDirectory($bundle, $payload)
    if (-not (Test-Path -LiteralPath (Join-Path $payload 'RedAgent\RedAgent.exe'))) { throw 'Verified archive is missing its executable.' }
    [ordered]@{ installer='orbitus-redagent'; version=$version; sourceCommit=$sourceCommit; archiveSHA256=$expected; distribution='development-pilot'; scope=$Scope; mdmEnrolled=$false } |
        ConvertTo-Json | Set-Content -LiteralPath (Join-Path $payload 'installation.json') -Encoding UTF8
    if (Test-Path -LiteralPath $InstallDir) {
        $backup = "$InstallDir.backup.$(Get-Date -Format yyyyMMddTHHmmss).$([guid]::NewGuid())"
        Move-Item -LiteralPath $InstallDir -Destination $backup
    }
    Move-Item -LiteralPath $payload -Destination $InstallDir
    $placed = $true
    Complete-Installation
    Write-Host "Installed RedAgent $version. Open: $exe"
    if ($backup) { Write-Host "Previous installation retained: $backup" }
    Write-Host 'Pilot build; production signing pending. Follow your normal device policy.'
    Write-Host 'MDM enrollment is not configured. Optional scanning/capture tools are installed separately.'
    if ($Scope -eq 'User') { Write-Host 'For persistent operation, open Cloud Fleet > Install system helper and complete the administrator prompt.' }
    Write-Host 'Then import your private enrollment and enable cloud commands. Closing the GUI leaves the helper running.'
} catch {
    if ($backup -and -not $placed -and -not (Test-Path -LiteralPath $InstallDir)) {
        Move-Item -LiteralPath $backup -Destination $InstallDir
    }
    throw
} finally {
    Remove-Item -LiteralPath $work -Recurse -Force
}
